@{
    ViewData["Title"] = "Dashboard";
}

<!-- Dashboard Page Heading -->
<h1>Organiser Dashboard</h1>

<p>Welcome to the RaceDay Management System.</p>

<!-- Dashboard Navigation Menu -->
<div class="list-group">

    <!-- Manage Events -->
    <a asp-controller="Event"
       asp-action="Index"
       class="list-group-item list-group-item-action">
        Manage Events
    </a>

    <!-- View Registrations -->
    <a asp-controller="Registration"
       asp-action="Index"
       class="list-group-item list-group-item-action">
        View Registrations
    </a>

    <!-- Manage Results -->
    <a asp-controller="Result"
       asp-action="Index"
       class="list-group-item list-group-item-action">
        Manage Results
    </a>

    <!-- Participant Dashboard -->
    <a asp-controller="Participant"
       asp-action="Index"
       class="list-group-item list-group-item-action">
        Participant Dashboard
    </a>

    <!-- Logout -->
    <a asp-controller="Account"
       asp-action="Logout"
       class="list-group-item list-group-item-action text-danger">
        Logout
    </a>

</div>