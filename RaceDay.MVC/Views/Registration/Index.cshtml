@model List<RaceDay.MVC.Models.Registration>

@{
    ViewData["Title"] = "Registration Management";
}

<h1>Registration Management</h1>

<p>
    This page displays participant registrations.
</p>

<hr />

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Registration ID</th>
            <th>Status</th>
            <th>Registration Date</th>
            <th>Event ID</th>
            <th>User ID</th>
            <th>Category ID</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            @foreach (var registration in Model)
            {
                <tr>
                    <td>@registration.RegistrationId</td>
                    <td>@registration.RegistrationStatus</td>
                    <td>@registration.RegistrationDate.ToShortDateString()</td>
                    <td>@registration.EventId</td>
                    <td>@registration.UserId</td>
                    <td>@registration.CategoryId</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">
                    No registrations found.
                </td>
            </tr>
        }

    </tbody>

</table>