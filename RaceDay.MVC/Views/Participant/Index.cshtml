@{
    ViewData["Title"] = "Participant Dashboard";
}

<!-- Participant Dashboard Heading -->
<h1>Participant Dashboard</h1>

<p>
    Welcome to the RaceDay Participant Portal.
</p>

<!-- Participant Navigation -->
<div class="list-group">

    <!-- Browse Events -->
    <a asp-controller="Event"
       asp-action="Index"
       class="list-group-item list-group-item-action">
        Browse Events
    </a>

    <!-- My Registrations -->
    <a asp-controller="Registration"
       asp-action="Index"
       class="list-group-item list-group-item-action">
        My Registrations
    </a>

    <!-- My Results -->
    <a asp-controller="Result"
       asp-action="Index"
       class="list-group-item list-group-item-action">
        My Results
    </a>

    <!-- Organiser Dashboard -->
    <a asp-controller="Dashboard"
       asp-action="Index"
       class="list-group-item list-group-item-action">
        Organiser Dashboard
    </a>

    <!-- Logout -->
    <a asp-controller="Account"
       asp-action="Logout"
       class="list-group-item list-group-item-action text-danger">
        Logout
    </a>

</div>