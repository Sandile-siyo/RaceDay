@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container py-4">

    <!-- Dashboard Heading -->
    <div class="text-center mb-5">

        <h1 class="display-5 fw-bold text-primary">
            🏃 Participant Dashboard
        </h1>

        <p class="lead text-muted">
            Welcome to your RaceDay Participant Portal.
        </p>

        <p class="text-muted">
            Browse upcoming races, manage your registrations
            and view your race results.
        </p>

    </div>


    <!-- Dashboard Cards -->
    <div class="row g-4 justify-content-center">

        <!-- Browse Events -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        🏁
                    </div>

                    <h4 class="fw-bold">
                        Browse Events
                    </h4>

                    <p class="text-muted">
                        Explore available RaceDay events
                        and choose your next race.
                    </p>

                    <a asp-controller="Event"
                       asp-action="Index"
                       class="btn btn-primary w-100">

                        Browse Events

                    </a>

                </div>

            </div>

        </div>


        <!-- My Registrations -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        📋
                    </div>

                    <h4 class="fw-bold">
                        My Registrations
                    </h4>

                    <p class="text-muted">
                        View and manage your current
                        race registrations.
                    </p>

                    <a asp-controller="Registration"
                       asp-action="Index"
                       class="btn btn-primary w-100">

                        View Registrations

                    </a>

                </div>

            </div>

        </div>


        <!-- My Results -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        🏆
                    </div>

                    <h4 class="fw-bold">
                        My Results
                    </h4>

                    <p class="text-muted">
                        View your race results,
                        positions and performance.
                    </p>

                    <a asp-controller="Result"
                       asp-action="Index"
                       class="btn btn-primary w-100">

                        View Results

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Account Actions -->
    <div class="row mt-5">

        <div class="col-md-8 mx-auto">

            <div class="card border-0 bg-light">

                <div class="card-body text-center p-4">

                    <h5 class="fw-bold mb-3">
                        Account
                    </h5>

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="btn btn-outline-danger px-4">

                        Logout

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>