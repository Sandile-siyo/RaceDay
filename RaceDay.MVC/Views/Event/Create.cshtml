@model RaceDay.MVC.ViewModels.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<!-- Create Event Page Heading -->
<h1>Create New Event</h1>

<!-- Event Creation Form -->
<form method="post" enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <!-- Display validation errors -->
    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <!-- Event Name -->
    <div class="mb-3">
        <label asp-for="EventName"
               class="form-label">
            Event Name
        </label>

        <input asp-for="EventName"
               class="form-control" />

        <span asp-validation-for="EventName"
              class="text-danger">
        </span>
    </div>

    <!-- Event Description -->
    <div class="mb-3">
        <label asp-for="EventDescription"
               class="form-label">
            Event Description
        </label>

        <input asp-for="EventDescription"
               class="form-control" />

        <span asp-validation-for="EventDescription"
              class="text-danger">
        </span>
    </div>

    <!-- Event Date -->
    <div class="mb-3">
        <label asp-for="EventDate"
               class="form-label">
            Event Date
        </label>

        <input asp-for="EventDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="EventDate"
              class="text-danger">
        </span>
    </div>

    <!-- Event Location -->
    <div class="mb-3">
        <label asp-for="Location"
               class="form-label">
            Location
        </label>

        <input asp-for="Location"
               class="form-control" />

        <span asp-validation-for="Location"
              class="text-danger">
        </span>
    </div>

    <!-- Event Distance -->
    <div class="mb-3">
        <label asp-for="Distance"
               class="form-label">
            Distance (KM)
        </label>

        <input asp-for="Distance"
               type="number"
               step="0.1"
               class="form-control" />

        <span asp-validation-for="Distance"
              class="text-danger">
        </span>
    </div>

    <!-- Event Type -->
    <div class="mb-3">
        <label asp-for="EventType"
               class="form-label">
            Event Type
        </label>

        <input asp-for="EventType"
               class="form-control" />

        <span asp-validation-for="EventType"
              class="text-danger">
        </span>
    </div>

    <!-- Event Image -->
    <div class="mb-3">
        <label asp-for="ImageFile"
               class="form-label">
            Event Image
        </label>

        <input asp-for="ImageFile"
               type="file"
               class="form-control"
               accept=".jpg,.jpeg,.png,.webp" />

        <div class="form-text">
            Choose a JPG, JPEG, PNG or WEBP image.
            Maximum size: 5 MB.
        </div>

        <span asp-validation-for="ImageFile"
              class="text-danger">
        </span>
    </div>

    <!-- Submit Button -->
    <button type="submit"
            class="btn btn-success">
        Save Event
    </button>

    <!-- Back Button -->
    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>