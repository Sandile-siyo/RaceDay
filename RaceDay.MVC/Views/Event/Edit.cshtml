@model RaceDay.MVC.ViewModels.EditEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<!-- Edit Event Heading -->
<h1>Edit Event</h1>

<!-- Edit Event Form -->
<form method="post" enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <!-- Display validation errors -->
    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <!-- Hidden Event Id -->
    <input asp-for="EventId" type="hidden" />

    <!-- Keep existing Image URL -->
    <input asp-for="ImageUrl" type="hidden" />

    <!-- Event Name -->
    <div class="mb-3">
        <label asp-for="EventName"
               class="form-label">
            Event Name
        </label>

        <input asp-for="EventName"
               class="form-control" />

        <span asp-validation-for="EventName"
              class="text-danger">
        </span>
    </div>

    <!-- Event Description -->
    <div class="mb-3">
        <label asp-for="EventDescription"
               class="form-label">
            Event Description
        </label>

        <input asp-for="EventDescription"
               class="form-control" />

        <span asp-validation-for="EventDescription"
              class="text-danger">
        </span>
    </div>

    <!-- Event Date -->
    <div class="mb-3">
        <label asp-for="EventDate"
               class="form-label">
            Event Date
        </label>

        <input asp-for="EventDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="EventDate"
              class="text-danger">
        </span>
    </div>

    <!-- Location -->
    <div class="mb-3">
        <label asp-for="Location"
               class="form-label">
            Location
        </label>

        <input asp-for="Location"
               class="form-control" />

        <span asp-validation-for="Location"
              class="text-danger">
        </span>
    </div>

    <!-- Distance -->
    <div class="mb-3">
        <label asp-for="Distance"
               class="form-label">
            Distance (KM)
        </label>

        <input asp-for="Distance"
               type="number"
               step="0.1"
               class="form-control" />

        <span asp-validation-for="Distance"
              class="text-danger">
        </span>
    </div>

    <!-- Event Type -->
    <div class="mb-3">
        <label asp-for="EventType"
               class="form-label">
            Event Type
        </label>

        <input asp-for="EventType"
               class="form-control" />

        <span asp-validation-for="EventType"
              class="text-danger">
        </span>
    </div>

    <!-- New Event Image -->
    <div class="mb-3">
        <label asp-for="ImageFile"
               class="form-label">
            Change Event Image
        </label>

        <input asp-for="ImageFile"
               type="file"
               class="form-control"
               accept=".jpg,.jpeg,.png,.webp" />

        <div class="form-text">
            Leave this empty to keep the current image.
            JPG, JPEG, PNG or WEBP only. Maximum size: 5 MB.
        </div>

        <span asp-validation-for="ImageFile"
              class="text-danger">
        </span>
    </div>

    <!-- Save Button -->
    <button type="submit"
            class="btn btn-success">
        Update Event
    </button>

    <!-- Back Button -->
    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>